# Copy to .env.local for local runs. Set the real values in Vercel (Preview + Production), never in git.

# Resend: sends the owner notification and the visitor confirmation (required).
RESEND_API_KEY=

# Notion: creates each enquiry in the Leads data source (optional; the email still goes out without it).
# The "ZYXEN Growth OS" page must be shared with the Notion integration that owns this token.
NOTION_TOKEN=
NOTION_LEADS_DATA_SOURCE_ID=84f7746c-7f37-4b2d-8442-0c9b282976aa
